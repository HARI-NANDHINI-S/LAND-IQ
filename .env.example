# BhoomiAI — Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Connection (required)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ IMPORTANT:
# NEVER add SUPABASE_SERVICE_ROLE_KEY to VITE_ variables.
# Service role operations belong in Supabase Edge Functions only.

# OCR Service (defaults to http://127.0.0.1:8001 for local dev; use HTTPS for production)
VITE_OCR_SERVICE_URL=http://127.0.0.1:8001
# Optional: Set if the deployed OCR service requires an API key
# VITE_OCR_API_KEY=your_ocr_service_api_key_here
