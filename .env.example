# LAND-IQ — Environment Configuration
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# 1. Public Browser Variables (Bundled into frontend client build)
# -----------------------------------------------------------------------------
# Supabase Project Connection (Required)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OCR Microservice Endpoint (Defaults to http://127.0.0.1:8001 for local dev; HTTPS for prod)
VITE_OCR_SERVICE_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# 2. Server-Side / Gateway Secrets (CRITICAL: NEVER PREFIX WITH VITE_)
# -----------------------------------------------------------------------------
# These credentials must remain strictly server-side and NEVER be bundled into frontend JS:
# - SUPABASE_SERVICE_ROLE_KEY : Kept exclusively in Supabase Edge Functions or admin backend.
# - OCR_API_KEY              : Kept exclusively in ocr-service/.env for server-to-server auth.
# - OCR_PROVIDER_API_KEY     : Stored in Supabase Edge Function secrets for process-document gateway.

