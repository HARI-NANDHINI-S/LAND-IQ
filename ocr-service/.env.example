# ==============================================================================
# LAND-IQ OCR & Machine Learning Microservice Configuration
# ==============================================================================

# Authentication Key (Optional for local dev, mandatory for production)
# When set, all non-public endpoints require 'Authorization: Bearer <KEY>' or 'X-API-Key: <KEY>'
OCR_API_KEY=

# Allowed CORS Origins (comma-separated URLs)
# Example: https://landiq.gov.in,https://admin.landiq.gov.in
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Concurrency & Semaphore Limits (Prevents CPU/Memory exhaustion during heavy OCR jobs)
MAX_CONCURRENT_OCR=4

# Maximum File Size Allowed for Uploads (Default: 25 MB in bytes)
MAX_FILE_SIZE_BYTES=26214400

# Maximum Allowed PDF Pages Per Document
MAX_PDF_PAGES=50

# Rate Limiting Protection (Max requests per minute per IP address, exempts /health & /ready)
RATE_LIMIT_PER_MINUTE=120

# Server Listening Port & Host
PORT=8001
HOST=0.0.0.0
